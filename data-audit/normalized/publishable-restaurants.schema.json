{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://food-council.local/schemas/publishable-restaurants.schema.json",
  "title": "Food Council publishable restaurants",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verifiedThrough",
    "sourceRecordCount",
    "count",
    "heldCount",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "verifiedThrough": {
      "type": "string",
      "format": "date"
    },
    "sourceRecordCount": {
      "type": "integer",
      "minimum": 0
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "heldCount": {
      "type": "integer",
      "minimum": 0
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/publicRecord"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": {
          "enum": ["official", "michelin", "tabelog", "other"]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "anyOf": [
            {"pattern": "^https://"},
            {"const": "http://www.genyamamoto.jp"}
          ]
        }
      }
    },
    "michelin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distinction", "edition", "verified", "sourceUrl"],
      "properties": {
        "distinction": {
          "type": ["string", "null"],
          "enum": [
            "three_stars",
            "two_stars",
            "one_star",
            "bib_gourmand",
            "selected",
            null
          ]
        },
        "edition": {
          "type": ["integer", "null"],
          "enum": [2026, null]
        },
        "verified": {
          "type": "boolean"
        },
        "sourceUrl": {
          "type": ["string", "null"],
          "format": "uri"
        }
      }
    },
    "publicRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "id",
        "name",
        "nameJa",
        "branch",
        "neighborhood",
        "michelin",
        "lastVerified",
        "sources"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 162
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "nameJa": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "neighborhood": {
          "type": "string",
          "minLength": 1
        },
        "michelin": {
          "$ref": "#/$defs/michelin"
        },
        "lastVerified": {
          "type": "string",
          "format": "date"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    }
  }
}
